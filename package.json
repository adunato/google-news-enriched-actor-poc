{
  "name": "google-news-enriched-actor-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "format:check": "prettier --check README.md AGENTS.md docs .github .codex package.json tsconfig.json eslint.config.js src scripts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "sample:publisher-resolution": "npm run build && node scripts/sample-publisher-resolution.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@nodable/entities": "^3.0.0",
    "apify": "^3.7.2",
    "fast-xml-parser": "^5.11.1"
  }
}
